 const rem=$('reminderList');rem.replaceChildren();const mine=familyData.reminders.filter(x=>x.owner===activeProfileId).sort((a,b)=>a.when.localeCompare(b.when));for(const x of mine)familyRow(rem,x.text+' — '+new Date(x.when).toLocaleString('ru-RU'),x.done,()=>{x.done=!x.done;familySave();familyRender()},()=>{familyData.reminders=familyData.reminders.filter(y=>y.id!==x.id);familySave();familyRender()});if(!mine.length)rem.textContent='Напоминаний пока нет.';
