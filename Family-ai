let ocrWorker=null,ocrWorkerPromise=null,ocrProgress=()=>{},ocrGeneration=0;
function loadOCRLibrary(){return new Promise((resolve,reject)=>{if(window.Tesseract)return resolve();const script=document.createElement('script');script.src='https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js';script.onload=resolve;script.onerror=()=>reject(Error('Не удалось загрузить библиотеку OCR'));document.head.append(script)})}
async function getOCRWorker(){
 if(ocrWorker)return ocrWorker;
 if(!ocrWorkerPromise){
  ocrWorkerPromise=(async()=>{
   await loadOCRLibrary();
   const worker=await Tesseract.createWorker('rus+eng',1,{logger:m=>ocrProgress(m)});
   ocrWorker=worker;return worker;
  })().catch(e=>{ocrWorkerPromise=null;throw e});
 }
 return ocrWorkerPromise;
}
async function recognizePhoto(data){const worker=await getOCRWorker();const result=await worker.recognize(data);return (result.data?.text||'').trim()}


