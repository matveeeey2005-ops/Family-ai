 time.onclick=()=>{info.textContent=cookingTiming(r)};
 ingredients.onclick=()=>{info.textContent='Для рецепта нужны: '+r.ingredients.join(', ')+'. Точные количества в исходной коллекции не указаны.'};
 controls.append(back,next);card.append(h,counter,instruction,controls,time,ingredients,info);chat.append(card);paint();chat.scrollTop=chat.scrollHeight;
}
function recoverCookingRecipe(){const c=cookingState();if(c.recipe)return c.recipe;for(let i=messages.length-1;i>=0;i--){const m=messages[i];if(m.role!=='bot'||!m.text.startsWith('🍲 '))continue;const name=m.text.split('\n')[0].slice(3).trim();const r=familyRecipes.find(x=>x.name===name);if(r){c.recipe=r;return r}}return null}

const recipeSearchInput=document.createElement('input');recipeSearchInput.id='recipeSearch';recipeSearchInput.placeholder='🔎 Поиск по 1000 рецептам';recipeSearchInput.setAttribute('aria-label','Поиск рецептов');
$('recipeSelect').before(recipeSearchInput);
const recipeCount=document.createElement('p');recipeCount.className='family-note';recipeCount.textContent='В коллекции '+familyRecipes.length+' вариантов рецептов · работает без интернета';recipeSearchInput.before(recipeCount);
function fillRecipeSelect(query=''){
 const select=$('recipeSelect');select.replaceChildren();let count=0;
 for(let i=0;i<familyRecipes.length;i++){if(query&&!recipeMatches(familyRecipes[i],query))continue;const o=document.createElement('option');o.value=String(i);o.textContent=familyRecipes[i].name;select.append(o);count++}
 if(!count){const o=document.createElement('option');o.value='';o.textContent='Ничего не найдено';select.append(o)}
 recipeCount.textContent='Найдено: '+count+' из '+familyRecipes.length+' рецептов';
}
fillRecipeSelect();recipeSearchInput.oninput=()=>fillRecipeSelect(recipeSearchInput.value);
function showFamilyRecipe(r){$('recipeResult').textContent=r?recipeText(r):'Выбери рецепт из списка.'}
$('recipeShow').onclick=()=>showFamilyRecipe(familyRecipes[Number($('recipeSelect').value)]);
$('recipeFind').onclick=()=>{
 const raw=$('ingredientsInput').value.trim();if(!raw){$('recipeResult').textContent='Напиши продукты через запятую.';return}
 const words=raw.split(/[,;\n]+/).map(recipeNorm).filter(Boolean);
 const ranked=familyRecipes.map(r=>({r,score:r.ingredients.filter(x=>words.some(w=>recipeMatches({name:x,ingredients:[]},w)>0)).length})).sort((a,b)=>b.score-a.score);
 if(!ranked[0].score){$('recipeResult').textContent='Совпадений не нашлось. Попробуй другие продукты.';return}
 showFamilyRecipe(ranked[0].r);$('recipeResult').textContent+='\n\nСовпало ингредиентов: '+ranked[0].score+'. Остальные проверь перед готовкой.';
};
// Вкладка может быть закрыта или выгружена: никаких обещаний фоновых уведомлений.
function familyCheckReminders(){const now=Date.now();let changed=false;for(const x of familyData.reminders){if(x.done||x.notified||x.owner!==activeProfileId)continue;const at=new Date(x.when).getTime();if(Number.isFinite(at)&&at<=now){x.notified=true;changed=true;if(document.visibilityState==='visible'){add('bot','🔔 Напоминание: '+x.text)}else{document.title='🔔 Напоминание — Family AI'}}}if(changed)familySave()}
setInterval(familyCheckReminders,30000);

</script>
