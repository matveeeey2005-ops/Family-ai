 if(state.step>=3){const score=state.correct;delete tutorMode[activeProfileId];return note+'\nВикторина окончена: '+score+' из 3. '+(score===3?'Отличная работа! 🌟':'Можем потренироваться ещё! 😊')}
 return note+'\nСледующий вопрос: '+questions[state.step-1]}
