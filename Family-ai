function tutorReply(raw){const s=normalize(raw),state=tutorMode[activeProfileId];
 if(/(?:начни|включи|давай|хочу|режим).*?(?:репетитор|викторин|провер|математик)/i.test(s)||/^(?:репетитор|викторина)$/i.test(s)){
