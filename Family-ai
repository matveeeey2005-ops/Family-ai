function searchPhrase(text){return text.replace(/^(расскажи(?: мне)?(?: пожалуйста)?(?: про| о)?|что такое|кто такой|кто такая|найди(?: информацию)?(?: про| о)?|объясни(?: что такое)?|что ты знаешь(?: про| о)?|поищи(?: про| о)?)\s+/i,'').replace(/[?!]+$/,'').trim().slice(0,130)||text.slice(0,130)}
// Краткая выжимка из вступления статьи: 1–3 полных предложения.
// Это извлечение, а не генерация нейросетью.
function shortSummary(raw){
 const clean=String(raw||'').replace(/\[[^\]]{1,35}\]/g,'').replace(/\s+/g,' ').trim();
 if(!clean)return 'Краткое описание недоступно.';
 const sentences=clean.match(/[^.!?]+(?:[.!?]+|$)/g)||[clean];
 const result=[];
 for(const sentence of sentences){
  const part=sentence.trim();
  if(!part)continue;
  if(result.length && result.join(' ').length+part.length>330)break;
  result.push(part);
  if(result.length>=3 || result.join(' ').length>=220)break;
 }
 let summary=result.join(' ').trim();
 if(!summary)summary=clean.slice(0,330).trim();
 return summary;
}
async function internetAnswer(question,signal){
 const term=searchPhrase(question).replace(/^(?:поищи|найди)(?: в (?:поиске|интернете))?\s*/i,'').replace(/,?\s*(?:поищи|найди)(?: в (?:поиске|интернете))?\s*(?:что за|что такое)?/i,' ').replace(/\bчто за порода\b/i,'порода собак').trim();
 const api='https://ru.wikipedia.org/w/api.php?origin=*&format=json&formatversion=2&action=query&generator=search&gsrsearch='+encodeURIComponent(term)+'&gsrlimit=1&prop=extracts|info&exintro=1&explaintext=1&exchars=1800&inprop=url';
 const response=await fetch(api,{signal});
 if(!response.ok)throw Error('HTTP '+response.status);
 const data=await response.json();
 const page=data.query?.pages?.[0];
 if(!page||page.missing)return {text:'По запросу «'+term+'» статья не найдена. Попробуй другой запрос.',google:term};
 const description=(page.extract||'').trim();
 return {text:'🌐 '+page.title+'\n\n'+shortSummary(description),url:page.fullurl||'https://ru.wikipedia.org/wiki/'+encodeURIComponent(page.title.replace(/ /g,'_')),google:term};
}
