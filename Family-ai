const recipeNorm=t=>String(t||'').toLowerCase().replace(/ё/g,'е').replace(/[^а-яa-z0-9]+/g,' ').trim();
const recipeTokens=t=>recipeNorm(t).split(/\s+/).filter(x=>x.length>=3);
function recipeMatches(r,query){const q=recipeTokens(query);if(!q.length)return 0;const hay=recipeTokens(r.name+' '+r.ingredients.join(' '));return q.reduce((score,w)=>score+(hay.some(x=>x===w||x.startsWith(w.slice(0,Math.max(3,w.length-2)))||w.startsWith(x.slice(0,Math.max(3,x.length-2))))?1:0),0)}
function recipeText(r){return '🍲 '+r.name+'\n\nИнгредиенты: '+r.ingredients.join(', ')+'.\n\nПриготовление:\n'+r.steps+'\n\n⚠️ При работе с плитой, духовкой и ножами соблюдай осторожность.'}
function recipeChatReply(raw){
