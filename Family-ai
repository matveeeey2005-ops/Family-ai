function weatherLabel(code){if(code===0)return 'Ясно ☀️';if(code<=3)return 'Переменная облачность ⛅';if(code<=48)return 'Туман 🌫️';if(code<=67)return 'Дождь 🌧️';if(code<=77)return 'Снег ❄️';if(code<=82)return 'Ливни 🌧️';if(code<=86)return 'Снегопад ❄️';if(code>=95)return 'Гроза ⛈️';return 'Облачно ☁️'}
async function getWeather(city,signal,tomorrow){
 const params=new URLSearchParams({latitude:city.lat,longitude:city.lon,current:'temperature_2m,relative_humidity_2m,weather_code,wind_speed_10m',daily:'temperature_2m_max,temperature_2m_min,precipitation_probability_max,weather_code',forecast_days:'3',timezone:'auto'});
 const res=await fetch('https://api.open-meteo.com/v1/forecast?'+params,{signal});if(!res.ok)throw Error('HTTP '+res.status);
 const data=await res.json();if(!data.current||!data.daily)throw Error('Нет данных прогноза');
 const today=data.daily;
 const idx=tomorrow?1:0;const fmt=n=>Math.round(n)+'°C';
 return '📍 '+city.name+'\n'+(tomorrow?'Завтра: ':'Сейчас: ')+(tomorrow?weatherLabel(today.weather_code[idx]):weatherLabel(data.current.weather_code))+'\n'+(tomorrow?'Температура: '+fmt(today.temperature_2m_min[1])+'…'+fmt(today.temperature_2m_max[1]):'Температура: '+fmt(data.current.temperature_2m))+'\n'+(tomorrow?'Вероятность осадков: '+(today.precipitation_probability_max[1]??'—')+'%':'Сегодня: '+fmt(today.temperature_2m_min[0])+'…'+fmt(today.temperature_2m_max[0])+'; ветер '+Math.round(data.current.wind_speed_10m)+' км/ч')+'\n'+(!tomorrow?'Завтра: '+fmt(today.temperature_2m_min[1])+'…'+fmt(today.temperature_2m_max[1])+'; осадки '+(today.precipitation_probability_max[1]??'—')+'%':'');
}
async function weatherAnswer(raw,signal){const cities=weatherTargets(raw);const tomorrow=/завтра/i.test(raw);const results=await Promise.allSettled(cities.map(c=>getWeather(c,signal,tomorrow))); return '🌤️ Погода · Open-Meteo\n\n'+results.map((r,i)=>r.status==='fulfilled'?r.value:'📍 '+cities[i].name+'\nНе удалось получить прогноз.').join('\n\n')+'\n\nДанные обновляются при запросе.'}
