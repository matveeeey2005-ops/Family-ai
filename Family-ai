 if(!/(?:рецепт|как приготовить|как готовить|как сделать|что приготовить|что можно приготовить)/.test(s))return null;
 const query=s.replace(/(?:покажи|дай|напиши|подскажи|мне|пожалуйста|рецепт|как приготовить|как готовить|как сделать|что приготовить|что можно приготовить|блюда|блюдо|из|для)/g,' ').trim();
 if(!query)return '🍲 В Family AI теперь 1000 вариантов рецептов! Напиши название блюда, например «рецепт гречки с грибами» или открой 🏡 Семейный центр → Рецепты.';
 const found=familyRecipes.map(r=>({r,score:recipeMatches(r,query)})).filter(x=>x.score>0).sort((a,b)=>b.score-a.score);
 if(!found.length)return 'Пока не нашёл подходящего рецепта в локальной коллекции. Попробуй название продукта или блюда, например «паста», «омлет», «суп».';
 const state=cookingState();state.recipe=found[0].r;state.step=0;state.active=false;
 return recipeText(found[0].r)+'\n\nНапиши «Давай приготовим вместе», чтобы открыть пошаговый виджет. 💚';
}

